===== 2. ssh: a shell with a pty, an exec, exit status and stderr
$ ssh -F $S/home/ssh/config -tt web1.koko tty; echo out; echo err >&2; exit 7
/dev/pts/0
out
err
Connection to web1.koko closed.
[exit 7]

===== 3. scp (sftp protocol), scp -O (legacy), sftp, rsync, with checksums
local 32m sha256 238d1e65d5498f08
$ scp -q -F $S/home/ssh/config $S/data/32m web1.koko:/tmp/up-scp
[exit 0]
$ scp -q -O -F $S/home/ssh/config $S/data/32m web1.koko:/tmp/up-scp-legacy
[exit 0]
$ scp -q -F $S/home/ssh/config web1.koko:/tmp/up-scp $S/data/down-scp
[exit 0]
$ sftp -q -F $S/home/ssh/config -b $S/data/sftp.batch web1.koko
sftp> put $S/data/32m /tmp/up-sftp
sftp> get /tmp/up-sftp $S/data/down-sftp
[exit 0]
$ rsync -a -e ssh -F $S/home/ssh/config $S/data/32m web1.koko:/tmp/up-rsync
[exit 0]
$ rsync -a -e ssh -F $S/home/ssh/config web1.koko:/tmp/up-rsync $S/data/down-rsync
[exit 0]
/tmp/up-scp 238d1e65d5498f08
/tmp/up-scp-legacy 238d1e65d5498f08
/tmp/up-sftp 238d1e65d5498f08
/tmp/up-rsync 238d1e65d5498f08
$S/data/down-scp 238d1e65d5498f08
$S/data/down-sftp 238d1e65d5498f08
$S/data/down-rsync 238d1e65d5498f08
rsync --version: openrsync: protocol version 29; Host: rsync  version 3.5.0  protocol version 32

===== 4. port forwards: -L to a Service on the Host's loopback, -D, -R
$ curl -s http://127.0.0.1:47180/
hello from a Service on web1
[exit 0]
$ curl -s --socks5-hostname 127.0.0.1:47181 http://127.0.0.1:8080/
hello from a Service on web1
[exit 0]
$ ssh -F $S/home/ssh/config -R 127.0.0.1:47182:127.0.0.1:47183 web1.koko sleep 0.5; wget -qO- http://127.0.0.1:47182/
hello from the device
[exit 0]

===== 5. how the Host name travels: case, user, port, HostName
$ ssh -F $S/home/ssh/config -p 2222 bob@WEB1.koko echo "Host Account: $(id -un)"
Host Account: deploy
[exit 0]
  server: server 10:18:22.777869 tunnel for "web1.koko" from alice/laptop accepted (tunnel@koko)
  server: server 10:18:22.781100 gateway web1: auth none from alice/laptop, ssh user "bob", client "SSH-2.0-OpenSSH_10.3"
Pseudo-terminal will not be allocated because stdin is not a terminal.
hostname web1.koko
hostkeyalias koko-proto
proxycommand "$S/bin/kokoproto" tunnel '%h'

===== 6. a name koko does not know
$ ssh -F $S/home/ssh/config web9.koko true
koko: no Host named "web9.koko" in your Spaces
Connection closed by UNKNOWN port 65535
[exit 255]

===== 7. agent and X11 forwarding asked for on the command line
$ ssh -F $S/home/ssh/config -A web1.koko echo "SSH_AUTH_SOCK=${SSH_AUTH_SOCK:-unset}"
SSH_AUTH_SOCK=unset
[exit 0]
$ ssh -F $S/home/ssh/config -X web1.koko echo "DISPLAY=${DISPLAY:-unset}"
DISPLAY=unset
[exit 0]
$ ssh -F $S/home/ssh/config -o SendEnv=LANG web1.koko echo "LANG=${LANG:-unset}"
LANG=en_US.UTF-8
[exit 0]
  server: server 10:18:22.887353 tunnel for "web9.koko" from alice/laptop refused: no such Host

===== 8. the Host is down (a recorded Host on a closed port)
$ ssh -F $S/home/ssh/config web2.koko true
koko: cannot reach web2: dial tcp 127.0.0.1:47099: connect: connection refused
Connection closed by UNKNOWN port 65535
[exit 255]

