# The koko server. kokod install, which koko server install runs, writes this
# file from the template in kokod, and writes it again at every run, so that
# it always matches kokod. Change a setting with a drop-in (systemctl edit
# koko), whose Environment= lines override the KOKO_* ones below.
[Unit]
Description=koko server
Documentation=https://github.com/cieons/koko
Wants=network-online.target
After=network-online.target

[Service]
Type=exec
ExecStart=/usr/local/bin/kokod run
Environment=KOKO_DATA_DIR=/var/lib/koko
Environment=KOKO_LISTEN=:7822
Environment=KOKO_LOG_LEVEL=info
# The Root Key's file is kokod run's default,
# $CREDENTIALS_DIRECTORY/root-key, which LoadCredential= makes.
LoadCredential=root-key:/etc/koko/root.key
User=koko
Group=koko
StateDirectory=koko
StateDirectoryMode=0700
RuntimeDirectory=koko
RuntimeDirectoryMode=0755
# No port needs a capability, so the koko server holds none. A port below
# 1024 needs CAP_NET_BIND_SERVICE: after moving KOKO_LISTEN or
# KOKO_WEB_LISTEN below 1024 with a drop-in, run koko server install
# again, which grants it here.
CapabilityBoundingSet=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
Restart=on-failure

[Install]
WantedBy=multi-user.target
