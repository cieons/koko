# Written by koko; it rewrites this file. Your own entries go in ~/.ssh/config.
Host *.koko web1
  HostName %h
  ProxyCommand "<profiles>/Alice Smith/.local/bin/koko.exe" tunnel '%h'
  HostKeyAlias koko
  UserKnownHostsFile ~/.ssh/koko/known_hosts
  StrictHostKeyChecking yes
  UpdateHostKeys no
  PreferredAuthentications none
  ForwardAgent no
  User koko
  ServerAliveInterval 30
  ServerAliveCountMax 4
